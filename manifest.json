{
  "manifest_version": 3,
  "name": "Local Gmail Command Center",
  "version": "2.0.30",
  "description": "2027-ready local command center for Gmail with multi-account monitoring, smart OTP detection, and zero external dependencies.",
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "offscreen",
    "sidePanel",
    "clipboardWrite",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://accounts.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Local Gmail Command Center",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
